<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Clean" Version="8.0.1" />
    <PackageVersion Include="HtmlAgilityPack" Version="[1.12.4,)" />
    <PackageVersion Include="Sekmen.StaticSiteGenerator" Version="0.2.0" />
    <PackageVersion Include="Umbraco.Cms" Version="18.0.2" />
    <PackageVersion Include="Umbraco.Cms.Web.Website" Version="[18.0.0,)" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="[18.0.0,)" />
    <PackageVersion Include="Umbraco.Cms.Api.Common" Version="[18.0.0,)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="[18.0.0,)" />
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Value="72.1.0.3" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="Microsoft.AspNetCore.App" Version="10.0.0" />
  </ItemGroup>
</Project>